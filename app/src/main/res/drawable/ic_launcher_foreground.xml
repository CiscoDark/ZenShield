    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Outer Shield Glow Shadow -->
    <path
        android:fillColor="#224DEEEA"
        android:pathData="M 54,23 L 78,30 C 78,58 66,73 54,85 C 42,73 30,58 30,30 Z" />

    <!-- Main Geometric Shield Body -->
    <path android:pathData="M 54,25 L 76,31 C 76,57 65,71 54,82 C 43,71 32,57 32,31 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="270"
                android:endX="54"
                android:endY="82"
                android:startX="54"
                android:startY="25"
                android:type="linear">
                <item android:color="#FF1A233A" android:offset="0.0" />
                <item android:color="#FF0D1322" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Shield Border Accent -->
    <path
        android:fillColor="#00000000"
        android:strokeWidth="2"
        android:pathData="M 54,25 L 76,31 C 76,57 65,71 54,82 C 43,71 32,57 32,31 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:angle="135"
                android:endX="76"
                android:endY="82"
                android:startX="32"
                android:startY="25"
                android:type="linear">
                <item android:color="#FF64B5F6" android:offset="0.0" />
                <item android:color="#FF38EF7D" android:offset="0.5" />
                <item android:color="#FF11998E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Internal Crescent Moon Emblem -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 54.5,37 C 47.6,37 42,42.6 42,49.5 C 42,56.4 47.6,62 54.5,62 C 58.2,62 61.5,60.4 63.8,57.8 C 58.8,57.2 55,52.9 55,47.7 C 55,42.8 58.5,38.7 63.3,37.8 C 60.7,37.3 57.7,37 54.5,37 Z" />

    <!-- Pulse/Focus Wave Rings -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#8064B5F6"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M 64,43 C 67.5,46 69,50 67.8,54.5" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#B338EF7D"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M 69,39 C 74,43.5 75.5,50 73.5,57.5" />

