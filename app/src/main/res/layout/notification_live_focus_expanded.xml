<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notification_hud_card_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- Header Row: M3 Tonal Emblem, Mode Title, Live Chronometer, and Tonal Status Chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_expanded_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/notification_chip_bg"
            android:contentDescription="@string/app_name"
            android:padding="5dp"
            android:src="@drawable/ic_launcher_monochrome"
            android:tint="#D3E3FD" />

        <TextView
            android:id="@+id/tv_expanded_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Gaming Focus"
            android:textColor="#E2E3EC"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/chrono_expanded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#A8C7FA"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tv_expanded_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#A8C7FA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_expanded_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/notification_chip_bg"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="Active"
            android:textColor="#D3E3FD"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtitle & Interactive Auto-Reply Tonal Chip Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_expanded_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Call Auto-Reply ON • Alerts Silenced"
            android:textColor="#C4C6D0"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_toggle_auto_reply"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/notification_chip_bg"
            android:minWidth="0dp"
            android:paddingStart="11dp"
            android:paddingTop="0dp"
            android:paddingEnd="11dp"
            android:paddingBottom="0dp"
            android:text="Auto-Reply: ON"
            android:textAllCaps="false"
            android:textColor="#D3E3FD"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Material 3 Rounded Progress Bar -->
    <ProgressBar
        android:id="@+id/pb_expanded_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="100"
        android:progressDrawable="@drawable/notification_live_progress" />

    <!-- Material 3 SurfaceContainerHigh Telemetry Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/notification_telemetry_box_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tv_live_calls_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="0"
                android:textColor="#A8C7FA"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Calls Declined"
                android:textColor="#E2E3EC"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/notification_telemetry_box_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tv_live_alerts_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="0"
                android:textColor="#D0BCFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Alerts Silenced"
                android:textColor="#E2E3EC"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Material 3 Tonal Pill Action Row: -15m | +15m | +30m | Mode | Turn Off -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_sub_15"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="0.85"
            android:background="@drawable/notification_button_bg"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="-15m"
            android:textAllCaps="false"
            android:textColor="#E2E3EC"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_add_15"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="0.85"
            android:background="@drawable/notification_button_accent_bg"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+15m"
            android:textAllCaps="false"
            android:textColor="#D3E3FD"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_add_30"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="0.85"
            android:background="@drawable/notification_button_accent_bg"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+30m"
            android:textAllCaps="false"
            android:textColor="#D3E3FD"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_cycle_mode"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.15"
            android:background="@drawable/notification_button_bg"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="Mode"
            android:textAllCaps="false"
            android:textColor="#E2E3EC"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_stop_focus"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1.15"
            android:background="@drawable/notification_button_danger_bg"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="Turn Off"
            android:textAllCaps="false"
            android:textColor="#F9DEDC"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
